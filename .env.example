AGENTICFIX_CACHE_DIR=.cache/repositories
AGENTICFIX_WORKTREE_DIR=.worktrees
AGENTICFIX_RUNS_DIR=runs
AGENTICFIX_MAX_FILE_BYTES=1048576
AGENTICFIX_MAX_READ_LINES=400
AGENTICFIX_MAX_TEST_TIMEOUT=60
AGENTICFIX_MAX_OUTPUT_BYTES=1048576
AGENTICFIX_MAX_ENTRIES=2000
AGENTICFIX_MAX_SCAN_ENTRIES=20000

# Model backend: deepseek | openai | gemini | qwen | claude | compatible
AGENTICFIX_MODEL_PROVIDER=deepseek
AGENTICFIX_MODEL_NAME=deepseek-flash
AGENTICFIX_MODEL_API_KEY=
# Optional; omit to use the provider preset. Do not append /chat/completions.
# AGENTICFIX_MODEL_BASE_URL=https://api.deepseek.com
# JSON objects; these cannot override tools, credentials or runtime token limits.
AGENTICFIX_MODEL_EXTRA_BODY={}
AGENTICFIX_MODEL_EXTRA_HEADERS={}
# OpenAI preset defaults to max_completion_tokens; others default to max_tokens.
# AGENTICFIX_MODEL_TOKEN_PARAMETER=max_tokens
AGENTICFIX_MODEL_TIMEOUT=90
AGENTICFIX_MAX_ITERATIONS=30
AGENTICFIX_MAX_TOOL_CALLS=60
AGENTICFIX_MAX_TOKEN_BUDGET=100000
AGENTICFIX_MAX_COMPLETION_TOKENS=4096
AGENTICFIX_MAX_RUN_DURATION=600
AGENTICFIX_MAX_MODEL_RETRIES=2
AGENTICFIX_RETRY_DELAY=1
AGENTICFIX_MAX_CONTEXT_BYTES=150000
AGENTICFIX_MAX_TOOL_MESSAGE_CHARS=12000
AGENTICFIX_MAX_REPEATED_ACTIONS=3
